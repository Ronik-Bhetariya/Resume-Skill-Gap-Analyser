# ========================================================
# Resume Skill Gap Analyzer - Environment Variables
# ========================================================

# Application Port (Local Development)
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String
# For Local: mongodb://127.0.0.1:27017/resume_skill_gap_db
# For Vercel Production: Use free MongoDB Atlas cluster connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resume_skill_gap_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_db_username:your_db_password@cluster0.mongodb.net/resume_skill_gap_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2026

# ========================================================
# Real Email OTP Configuration (Nodemailer / SMTP)
# ========================================================
# Option 1: Standard SMTP (Gmail, Brevo, SendGrid, Amazon SES, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Resume Skill Gap Analyzer <noreply@skillgap.ai>

# Option 2: Direct Gmail Service
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password
